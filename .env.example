VITE_USE_MOCK=true
VITE_API_URL=http://localhost:3000/api

# Supabase. Vite só expõe pro client variáveis com prefixo VITE_ — não use
# NEXT_PUBLIC_ aqui (é de Next.js).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Liga só o repositório de Serviceiros no Supabase real, independente do
# VITE_USE_MOCK acima (resto do app ainda não tem implementação HTTP).
VITE_SERVICEIROS_USE_SUPABASE=false

# Liga só o repositório de Loot Drops no Supabase real, independente do
# VITE_USE_MOCK acima (resto do app ainda não tem implementação HTTP).
VITE_LOOTDROPS_USE_SUPABASE=false

# Liga a resolução de conta (accountId) ao usuário logado via Supabase Auth, em vez do
# mockAccount fixo. Só funciona depois de rodar a migration
# 20260814000000_enable_rls_with_auth.sql e ligar um usuário real a uma conta (accounts.user_id).
VITE_ACCOUNT_USE_SUPABASE=false

# Liga o cadastro de membros (Configurações) no Supabase real, em vez do array mock fixo.
# Só funciona depois de rodar a migration 20260814010000_create_members_table.sql.
VITE_MEMBER_USE_SUPABASE=false

# Liga os splits salvos da Calculadora de Split Loot no Supabase real, em vez do mock em
# memória. Só funciona depois de rodar a migration 20260819000000_create_split_logs_table.sql.
VITE_SPLIT_LOGS_USE_SUPABASE=false

# Planilha pessoal (Google Sheets) usada pra XP e Boss/Hunt reais no Dashboard/Histórico.
# SEM prefixo VITE_ de propósito — essas variáveis só devem existir no lado servidor
# (Vercel Function em api/, ou vite.config.ts em dev), nunca no bundle do client. O ID
# da planilha, sozinho, já dá acesso de leitura total a ela (compartilhamento "qualquer
# um com o link") — não commitar o valor real, só configurar local/Vercel.
XP_SHEET_ID=coloque_o_id_da_sua_planilha_aqui
XP_SHEET_XP_REALIZADA_GID=gid_da_aba_de_xp
XP_SHEET_BOSS_HUNT_GID=gid_da_aba_de_boss_hunt
