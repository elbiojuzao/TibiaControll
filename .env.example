VITE_USE_MOCK=true
VITE_API_URL=http://localhost:3000/api

# Supabase. Vite só expõe pro client variáveis com prefixo VITE_ — não use
# NEXT_PUBLIC_ aqui (é de Next.js).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Liga só o repositório de Serviceiros no Supabase real, independente do
# VITE_USE_MOCK acima (resto do app ainda não tem implementação HTTP).
VITE_SERVICEIROS_USE_SUPABASE=false

# Liga só o repositório de Loot Drops no Supabase real, independente do
# VITE_USE_MOCK acima (resto do app ainda não tem implementação HTTP).
VITE_LOOTDROPS_USE_SUPABASE=false
