VITE_USE_MOCK=true
VITE_API_URL=http://localhost:3000/api

# Supabase. Vite só expõe pro client variáveis com prefixo VITE_ — não use
# NEXT_PUBLIC_ aqui (é de Next.js). Desde 2026-09-30 também são lidas SERVER-SIDE por
# api/login.ts/api/_lib/login.ts (proxy de login com rate limit, ver businessLogic.
# loginRateLimit em docs/architecture.json) — o prefixo VITE_ só controla se o Vite injeta
# no bundle do browser, não impede leitura via process.env numa Vercel Function.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Liga só o repositório de Serviceiros no Supabase real, independente do
# VITE_USE_MOCK acima (resto do app ainda não tem implementação HTTP).
VITE_SERVICEIROS_USE_SUPABASE=false

# Liga só o repositório de Loot Drops no Supabase real, independente do
# VITE_USE_MOCK acima (resto do app ainda não tem implementação HTTP).
VITE_LOOTDROPS_USE_SUPABASE=false

# Liga a resolução de conta (accountId) ao usuário logado via Supabase Auth, em vez do
# mockAccount fixo. Só funciona depois de rodar a migration
# 20260814000000_enable_rls_with_auth.sql e ligar um usuário real a uma conta (accounts.user_id).
VITE_ACCOUNT_USE_SUPABASE=false

# Liga o cadastro de membros (Configurações) no Supabase real, em vez do array mock fixo.
# Só funciona depois de rodar a migration 20260814010000_create_members_table.sql.
VITE_MEMBER_USE_SUPABASE=false

# Liga os splits salvos da Calculadora de Split Loot no Supabase real, em vez do mock em
# memória. Só funciona depois de rodar a migration 20260819000000_create_split_logs_table.sql.
VITE_SPLIT_LOGS_USE_SUPABASE=false

# Liga os eventos de party cadastrados pelo usuário no Calendário no Supabase real, em vez
# do mock em memória. Só funciona depois de rodar a migration
# 20260825000000_create_party_events_table.sql.
VITE_PARTY_EVENTS_USE_SUPABASE=false

# Liga os presets salvos da Roda de Destino no Supabase real, em vez do mock em memória.
# Só funciona depois de rodar a migration 20260908010000_create_wheel_presets_table.sql.
VITE_WHEEL_PRESETS_USE_SUPABASE=false

# Liga o histórico de XP (Dashboard, Histórico de XP, Calendário) lido da tabela
# member_xp_snapshots no Supabase real, em vez do mock vazio. Só funciona depois de rodar as
# migrations 20261002010000 e 20261002020000 (e o backfill do histórico).
VITE_MEMBER_XP_USE_SUPABASE=false

# Cron diário de coleta de XP (api/cron/xp-collect, agendado em vercel.json às 06:30 BRT).
# SERVER-SIDE ONLY (sem prefixo VITE_ — nunca no bundle do client). NÃO usa service role key:
# o cron chama as funções RPC xp_cron_targets/xp_cron_save (migration 20261002030000) com a
# chave publishable acima + este segredo. CRON_SECRET é qualquer string aleatória longa; a
# Vercel manda ela como "Authorization: Bearer" nas execuções do cron, e o SHA-256 dela precisa
# estar em private.cron_secrets (name='xp_collect') no banco — ver comentário da migration.
CRON_SECRET=coloque_uma_string_aleatoria_longa_aqui
